# Resend (recommended for order & transactional emails)
# Get API key: https://resend.com/api-keys
# Verify your domain in Resend → Domains, then use an address on that domain:
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=orders@mb-something.co.uk
RESEND_FROM_NAME="M-B Something"
# Where new-order notifications go (comma-separated for multiple recipients)
ADMIN_EMAIL=you@yourdomain.co.uk
# Shown on site footer / reply-to in outgoing emails
CONTACT_EMAIL=support@mb-something.co.uk

# Inbound email forwarding (when someone emails CONTACT_EMAIL)
# 1. Resend → Domains → mb-something.co.uk → enable Receiving (add MX records)
# 2. Resend → Webhooks → Add → https://yourdomain.com/api/webhooks/resend/inbound
#    Event: email.received — copy signing secret below
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# Optional: only forward mail sent to this address (defaults to CONTACT_EMAIL)
RESEND_INBOUND_ADDRESS=orders@mb-something.co.uk

# Supabase Configurations
# Database Connection Strings (eu-west-2 London)
DATABASE_URL=postgresql://postgres.rrpmpvffewatuldyytqf:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rrpmpvffewatuldyytqf.supabase.co:5432/postgres

# Supabase API & Auth (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://rrpmpvffewatuldyytqf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Payment Gateways (Stripe handles Cards + Apple Pay + Klarna; PayPal handles PayPal)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
